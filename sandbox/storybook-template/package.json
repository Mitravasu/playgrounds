{
  "name": "playgrounds-storybook-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storybook": "storybook dev --host 127.0.0.1 --no-open --disable-telemetry",
