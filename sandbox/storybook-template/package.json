    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "storybook": "10.5.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
