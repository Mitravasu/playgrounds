# Copy this file to .env and replace the placeholder with your Ollama API key.
OLLAMA_API_KEY=replace_with_your_ollama_api_key
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:cloud
CREATOR_MODEL=gemma4:cloud
REVIEWER_MODEL=gemma4:cloud
CREATOR_MAX_COMPONENTS=4
# Optional: set both keys to trace every Ollama chat call in Langfuse.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
OLLAMA_STRUCTURED_OUTPUTS=false
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_PLANNING_TIMEOUT_SECONDS=120
PLAYGROUNDS_SANDBOX_IMAGE=playgrounds-browser:latest
PLAYGROUNDS_RUNS_DIRECTORY=runs
PLAYGROUNDS_STORYBOOKS_DIRECTORY=storybooks
